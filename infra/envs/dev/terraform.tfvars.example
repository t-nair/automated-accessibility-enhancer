# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# From the bootstrap output of the same name.
state_bucket_name = "aae-tfstate-CHANGE-ME"

project     = "aae"
environment = "dev"
aws_region  = "us-east-1"

# Set this to the tag you pushed to ECR. "latest" works to start with, but
# pinning a build number is what makes a rollback possible.
image_tag = "latest"

# us-east-1 is where captioning was proven to work. Asking us-west-2 or
# us-east-2 for one of these models answers "the model does not exist".
bedrock_region = "us-east-1"

# An inference profile id: "us." in front, and a version on the end. The short
# form belongs to a different Bedrock endpoint and is rejected here.
bedrock_model_id = "us.anthropic.claude-haiku-4-5-20251001-v1:0"

# How long real course material sits in S3.
uploads_expiration_days   = 7
processed_expiration_days = 30

# Backups. A deleted or overwritten file can be restored for this many days, and
# the submissions table can be restored to any second in the last 35 days.
noncurrent_version_expiration_days = 3
submissions_point_in_time_recovery = true
buckets_force_destroy              = false

# Confirm the subscription email AWS sends, or these get nothing.
alarm_email_addresses = ["you@uw.edu"]

github_repository = "t-nair/automated-accessibility-enhancer"

# Sign-in (see "Sign-in" in infra/README.md). Email and password work with none
# of these set; each provider turns on once its id is set.
public_url            = "https://accessibilityenhancer.com/app"
cognito_domain_prefix = "accessibility-enhancer"
# google_client_id        = ""
# google_client_secret    = ""
# microsoft_client_id     = ""
# microsoft_client_secret = ""
# microsoft_tenant_id     = "9188040d-6c67-4c5b-b112-36a304b66dad"
# email_domain            = "accessibilityenhancer.com"
# email_domain_verified   = false

# Set to false if this AWS account already has a GitHub OIDC provider.
create_oidc_provider = true
