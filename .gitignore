# Virtual environment - never commit this, it is huge and machine specific
venv/

# Python cache
__pycache__/
*.pyc

# Faculty uploads and processed results - real course materials, keep them off GitHub
uploads/
processed/
pptx_output/
pptx_input/

# Runtime data and logs. The whole folder rather than the files in it, because
# everything the app writes there is runtime data, and naming them one at a time
# means anything else that lands in it gets committed by accident.
data/
pipeline.log

# Terraform working directories and provider downloads
**/.terraform/*

# State, and the local state the bootstrap step leaves behind. Never commit
# these: state holds resource ids and can hold values that were meant to stay
# out of the repository.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Real variable values. The .example files next to them are committed instead.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Saved plans, which are a snapshot of state as much as of the diff
tfplan
*.tfplan

crash.log
crash.*.log

# .terraform.lock.hcl is deliberately not ignored: it pins provider versions,
# so committing it is what makes a plan reproducible.
